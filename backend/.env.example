PORT=5000

# Groq API key (free tier) - https://console.groq.com/keys
# Also powers get_weather/generate_image reasoning, plus voice
# transcription (Whisper) and text-to-speech (Orpheus) — no extra key
# needed for those. Orpheus TTS requires a one-time terms acceptance at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tavily web search API key (free tier) - https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Jina AI Reader key (optional) - https://jina.ai/reader
# Powers the read_page tool. Works with no key at 20 requests/min;
# a free key raises that to 500 requests/min but comes with a fixed
# 10,000,000-token LIFETIME allowance (not a monthly quota) — once
# spent, generate a new key. Leave blank to use the keyless tier.
JINA_API_KEY=

# GitHub personal access token (optional) - https://github.com/settings/tokens
# Powers the explain_github_repo tool. Works with no token at 60 requests/hour
# per IP; a token (no scopes needed for public repos) raises that to 5,000/hour.
# Leave blank to use the unauthenticated tier.
GITHUB_TOKEN=

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/agnet

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Secret used to sign admin login JWTs — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_TOKEN_TTL=7d
